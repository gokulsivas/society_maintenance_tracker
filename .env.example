# ==========================================================
# Society Maintenance Tracker — Environment Configuration
# ==========================================================

# ----------------------------------------------------------
# Backend Server-Side Secrets (NEVER expose to frontend)
# ----------------------------------------------------------

# Database (PostgreSQL on Neon — pooled connection string with SSL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Environment ('development' | 'production')
ENVIRONMENT=development

# JWT Authentication (Secret Key for signing JWTs)
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_9876543210
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (Photo Storage — server-side credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Brevo REST API — optional server-side credentials)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Socivio
FRONTEND_URL=http://localhost:5173

# CORS (Explicit allowed origins — comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Seed Defaults (For initial database population)
SEED_ADMIN_EMAIL=admin@society.com
SEED_ADMIN_NAME="Society Admin"
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FLAT="Office-101"

SEED_RESIDENT_EMAIL=resident@society.com
SEED_RESIDENT_NAME="John Resident"
SEED_RESIDENT_PASSWORD=Resident@12345
SEED_RESIDENT_FLAT="A-101"

# ----------------------------------------------------------
# Frontend Build-Time Variables (Non-sensitive only)
# ----------------------------------------------------------
VITE_API_URL=/api
